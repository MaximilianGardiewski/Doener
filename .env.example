# Browser-safe / public project information
PUBLIC_SITE_URL=http://localhost:4173
SUPABASE_URL=

# Current runtime key names (legacy JWT API keys, still supported by self-hosted Supabase).
# The new opaque SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY migration is a
# separate compatibility slice because sb_* keys are not JWTs.
SUPABASE_ANON_KEY=

# Server-only
SUPABASE_SERVICE_ROLE_KEY=
MCELLO_LOCATION_ID=00000000-0000-4000-8000-000000000001
# Keep "mcello" for the canonical seed; use a distinct namespace for another location.
MCELLO_MENU_SEED_NAMESPACE=mcello

# Notification adapters (provider chosen later)
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_ID=
SMS_PROVIDER=
SMS_API_TOKEN=
SMS_SENDER_ID=

# OTP
OTP_TTL_SECONDS=300

# Never commit real values.
