# Copy to infra/selfhost/app.env on the server and chmod 600.
# Never commit real values.

NODE_ENV=production
PUBLIC_SITE_URL=https://www.example.invalid

# Public HTTPS Supabase gateway used for customer-facing Realtime URLs and API access.
SUPABASE_URL=https://api.example.invalid

# Current runtime supports the legacy JWT API-key generation used by the existing
# local integration stack. Self-hosted Supabase can run legacy and new sb_* keys
# side-by-side while the runtime migrates to opaque publishable/secret keys.
SUPABASE_ANON_KEY=replace-with-generated-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-generated-service-role-key

MCELLO_LOCATION_ID=00000000-0000-4000-8000-000000000001
MCELLO_MENU_SEED_NAMESPACE=mcello
OTP_TTL_SECONDS=300

# Production messaging remains disabled until separately approved/configured.
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_ID=
SMS_PROVIDER=
SMS_API_TOKEN=
SMS_SENDER_ID=
