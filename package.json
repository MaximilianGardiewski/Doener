{
  "name": "business-web-factory",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:domain": "node --experimental-strip-types --test packages/*/test/*.test.ts",
    "preview:mcello": "node apps/mcello/dev-server.mjs",
    "check": "npm run test:domain && npm run test:schema",
    "test:schema": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
